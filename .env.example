# Per-host configuration. In Dokploy this goes in the compose's Environment tab.
# Never commit real values.

# --- identity ---------------------------------------------------------------
# Kopia tags snapshots as user@hostname. Use the host's name so the UI is
# readable: web-1, db-2, control-plane.
KOPIA_HOSTNAME=example-host
SNAPSHOT_DESCRIPTION=example-host nightly

# --- schedule ---------------------------------------------------------------
# Time of day in UTC, HH:MM. The container sleeps until this time, runs the
# backup, and repeats — no external scheduler is involved, so backups keep
# running even if the control plane that deployed this is gone.
#
# Verify without waiting a day:
#   docker compose exec kopia run-scheduler.sh --next
BACKUP_AT=03:00

# --- image ------------------------------------------------------------------
# Pin to a commit sha once you have one; `latest` is only for a first deploy.
# IMAGE_TAG=sha-0000000000000000000000000000000000000000

# --- repository -------------------------------------------------------------
# Without KOPIA_PASSWORD the backups are unrecoverable. It is not stored here.
KOPIA_PASSWORD=
B2_KEY_ID=
B2_APP_KEY=
# All three are required — there are no defaults, because they identify one
# specific repository and do not belong in a public file.
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=

# --- sources ----------------------------------------------------------------
# Any number of each. The suffix after the prefix becomes the filename, so
# PG_SOURCE_example produces /staging/postgres/example.dump.
#
#   PG_SOURCE_*     one database, pg_dump custom format — allows selective
#                   restore of individual tables later.
#   PGALL_SOURCE_*  a whole cluster, pg_dumpall — every database *plus* roles
#                   and grants. Use this when one Postgres server hosts several
#                   application databases: pg_dump alone restores the data but
#                   leaves you with no logins and no permissions.
PG_SOURCE_example=postgresql://user:pass@example-db:5432/example
# PGALL_SOURCE_cluster=postgresql://admin:pass@example-postgres:5432/postgres

# RCLONE_SOURCE_<label>=<remote>:<path>, mirrored to /staging/files/<label>.
# RCLONE_SOURCE_media=s3:example-media

# Credentials for the `s3:` remote referenced above.
#
# These names are not arbitrary. rclone builds an implicit remote from
# RCLONE_CONFIG_<NAME>_<SETTING>, so `RCLONE_CONFIG_S3_*` defines the remote
# called `s3`. Anything else — RCLONE_S3_* for instance — is silently ignored
# and rclone fails with "didn't find section in config file".
# TYPE is required; without it the remote does not exist at all.
# RCLONE_CONFIG_S3_TYPE=s3
# RCLONE_CONFIG_S3_PROVIDER=AWS
# RCLONE_CONFIG_S3_REGION=us-east-1
# RCLONE_CONFIG_S3_ACCESS_KEY_ID=
# RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
# For a non-AWS S3 (RustFS, B2, R2) set the endpoint too:
# RCLONE_CONFIG_S3_ENDPOINT=https://s3.example.com

# --- reporting --------------------------------------------------------------
# Uptime Kuma push monitor. Without this a failed run is silent, which is
# exactly how a previous backup stayed broken for four days.
KUMA_PUSH_URL=https://status.example.com/api/push/XXXXXXXXXX

# Optional: a direct Telegram alert naming which source failed and why, so a
# failure does not require opening a dashboard to diagnose.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_THREAD_ID=

# Abort before starting if the staging volume has less than this free.
MIN_FREE_MB=2048
